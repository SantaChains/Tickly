// DPI 感知清单的资源包装：只给 mingw-w64（windres）用。
// MSVC 由 CMake 把 assets/app.manifest 作为 manifest 输入交给 link.exe
//（/MANIFESTINPUT），不走 .rc —— 否则会与 CMake 自动 /MANIFEST:EMBED
// 产生的清单重复（CVT1100: 资源重复 MANIFEST）。
#include <windows.h>

// 本文件是 UTF-8：显式声明代码页，windres / llvm-rc 都按 UTF-8 解析中文
#pragma code_page(65001)

1 24 "app.manifest"
